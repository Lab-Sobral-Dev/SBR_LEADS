# ===========================================
# PROSPEC LEADS - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git

# Ambiente (development | production)
APP_ENV=development

# Chave secreta para JWT (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-insecure-change-me-in-production

# PostgreSQL
POSTGRES_USER=prospec
POSTGRES_PASSWORD=altere_esta_senha_local
POSTGRES_DB=prospec_db

# pgAdmin (interface web do banco em http://localhost:5050)
[email protected]
PGADMIN_PASSWORD=altere_esta_senha_pgadmin

# Configurações da aplicação (futuras etapas)
# LOG_LEVEL=INFO
# DEFAULT_PAGE_SIZE=50

# ===========================================
# Integração Pedido Mobile (cruzar leads com clientes dos vendedores)
# ===========================================
PEDIDO_MOBILE_BASE_URL=https://pedidomobile.com/webservice/v3
[email protected]
PEDIDO_MOBILE_PASSWORD=preencha_no_env_local

# ===========================================
# ETL — scripts etl/ (Etapa 2)
# ===========================================
# Os scripts ETL usam DATABASE_URL acima quando rodando via Docker (serviço etl).
# Para rodar fora do Docker (host), ajuste o host para localhost:
# ETL_DATABASE_URL=postgresql://prospec:altere_esta_senha_local@localhost:5433/prospec_db

# ─── Protocolo de Acoplamento (gestao-sbr) ───────────────────────────────────
# Segredo compartilhado com o casco; nunca versionar. Ausente = /api/auth/sso
# devolve 503 e o app segue funcionando com o login próprio.
DOCKING_SECRET=segredo_compartilhado_com_o_gestao_sbr

# Origem autorizada a embutir este app em iframe.
FRAME_ANCESTOR=http://gestao.labsobralnet.ind

# Flag Secure do cookie. Deixe false em rede interna HTTP: forçar Secure faz o
# navegador descartar o cookie e gera loop de login. Ligue quando houver TLS.
SESSION_COOKIE_SECURE=false
